#!/bin/sh

berryc border_width 4
berryc inner_border_width 0
berryc title_height 24
berryc top_gap 26
berryc edge_gap 0 0 0 0
berryc set_font "Xanh Mono-14"

berryc smart_place true
berryc draw_text true
berryc json_status true
berryc decorate_new true
berryc pointer_interval 0

berryc manage Dialog
berryc manage Menu
berryc manage Utility

berryc unmanage Toolbar
berryc unmanage Splash

berryc name_desktop 0 "1"
berryc name_desktop 1 "2"
berryc name_desktop 2 "3"
berryc name_desktop 3 "4"
berryc name_desktop 4 "5"
berryc name_desktop 5 "6"
berryc name_desktop 6 "7"
berryc name_desktop 7 "8"
berryc name_desktop 8 "9"
berryc name_desktop 9 "10"

sh "$HOME/.config/berry/colors"
